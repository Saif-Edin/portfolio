---
import { it } from '../i18n/it'
import { en } from '../i18n/en'
import '../styles/global.css'

interface Props {
  title?: string
}
const { title = 'SaifEdin — Full-stack developer' } = Astro.props
---

<!doctype html>
<html lang="it" data-lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SaifEdin — Full-stack developer & Computer Engineering student" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content="SaifEdin — Full-stack developer & Computer Engineering student" />
    <meta property="og:type" content="website" />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />}
  </head>
  <body>
    <nav class="nav">
      <a href="/" class="nav-logo">SaifEdin</a>
      <div class="nav-links">
        <a href="/#projects" data-i18n="nav.projects">Progetti</a>
        <a href="/#contact" data-i18n="nav.contact">Contatti</a>
        <button class="lang-toggle" onclick="window.toggleLang()" data-i18n="nav.toggle">EN</button>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <span>SaifEdin · {new Date().getFullYear()}</span>
    </footer>

    <script define:vars={{ it, en }}>
      const STORAGE_KEY = 'lang'

      function updateTranslations(translations) {
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n')
          const value = key.split('.').reduce((obj, k) => obj?.[k], translations)
          if (value !== undefined) el.textContent = value
        })
      }

      function applyLang(lang) {
        document.documentElement.setAttribute('data-lang', lang)
        document.documentElement.lang = lang
        localStorage.setItem(STORAGE_KEY, lang)
        updateTranslations(lang === 'en' ? en : it)
      }

      window.toggleLang = function () {
        const current = document.documentElement.getAttribute('data-lang')
        applyLang(current === 'it' ? 'en' : 'it')
      }

      // Apply saved lang on load (only accept known values)
      const saved = localStorage.getItem(STORAGE_KEY)
      if (saved === 'en') applyLang('en')
    </script>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--color-soft);
    transition: color 0.15s;
  }

  .nav-links a:hover { color: var(--color-text); }

  .lang-toggle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-soft);
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .lang-toggle:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-soft);
    font-family: var(--font-mono);
  }
</style>
