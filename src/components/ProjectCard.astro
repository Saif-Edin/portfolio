---
interface Props {
  title: string
  description: string
  descriptionKey?: string
  tech: string[]
  href: string
  wip?: boolean
}

const { title, description, descriptionKey, tech, href, wip = false } = Astro.props
---

<a class="card" href={href}>
  <div class="card-header">
    <h3 class="card-title">{title}</h3>
    {wip && <span class="wip-badge" data-i18n="projects.wip">In progress</span>}
  </div>
  <p class="card-desc" data-i18n={descriptionKey || undefined}>{description}</p>
  <div class="card-footer">
    <div class="card-tech">
      {tech.map(t => <span class="tech-tag">{t}</span>)}
    </div>
    <span class="card-link" data-i18n="projects.view">Vedi progetto →</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: var(--color-primary);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .wip-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 0.2rem 0.5rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--color-soft);
    line-height: 1.6;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-soft);
    background: var(--color-border);
    padding: 0.15rem 0.4rem;
  }

  .card-link {
    font-size: 0.8rem;
    color: var(--color-primary);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
