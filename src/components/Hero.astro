---
---

<section class="hero" id="hero">
  <div class="hero-inner">
    <span class="hero-eyebrow" data-i18n="hero.eyebrow">Full-stack developer</span>
    <h1 class="hero-name">SaifEdin</h1>
    <p class="hero-tagline" data-i18n="hero.tagline">
      Ingegneria Informatica · sviluppo web end-to-end, dal frontend al backend.
    </p>
    <div class="hero-ctas">
      <a href="#projects" class="cta-primary" data-i18n="hero.cta_projects">Vedi i progetti</a>
      <a href="#contact" class="cta-ghost" data-i18n="hero.cta_contact">Contattami</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 57px);
    display: flex;
    align-items: flex-start;
    padding: 18vh 2rem 4rem;
  }

  .hero-inner {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 1.5rem;
  }

  .hero-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .hero-tagline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-soft);
    max-width: 50ch;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.15s;
  }

  .cta-primary:hover { opacity: 0.85; }

  .cta-ghost {
    border: 1px solid var(--color-text);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.15s, color 0.15s;
  }

  .cta-ghost:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
