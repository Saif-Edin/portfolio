---
import Base from '../../layouts/Base.astro'

const tech = ['Java', 'SQL', 'HTML', 'CSS', 'JavaScript']
---

<Base title="AFAM Experience Platform — SaifEdin">
  <article class="project-page">
    <div class="project-inner">
      <a href="/#projects" class="back-link" data-i18n="projects.back">← Progetti</a>

      <header class="project-header">
        <span class="project-badge" data-i18n="projects.wip">In progress</span>
        <h1 class="project-title">AFAM Experience Platform</h1>
        <p class="project-meta" data-i18n="projectPage.afam.meta">Ingegneria del Software · UniPa</p>
      </header>

      <section class="project-section">
        <h2 data-i18n="projectPage.sections.description">Descrizione</h2>
        <p data-i18n="projectPage.afam.description">
          Sistema web per la catalogazione e la condivisione volontaria di esperienze, curriculum e materiali
          da parte degli studenti delle Accademie di Belle Arti e Musica (AFAM).
          L'obiettivo è creare una piattaforma che permetta agli studenti di condividere
          il proprio percorso formativo e professionale con la comunità accademica.
        </p>
      </section>

      <section class="project-section">
        <h2 data-i18n="projectPage.sections.role">Il mio ruolo</h2>
        <p data-i18n="projectPage.afam.role">
          Sviluppo full-stack: progettazione del database, implementazione del backend,
          sviluppo dell'interfaccia utente e integrazione dei componenti.
        </p>
      </section>

      <section class="project-section">
        <h2 data-i18n="projectPage.sections.stack">Tech stack</h2>
        <div class="tech-list">
          {tech.map(t => <span class="tech-pill">{t}</span>)}
        </div>
      </section>

      <section class="project-section">
        <h2 data-i18n="projectPage.sections.screenshots">Screenshot</h2>
        <div class="screenshot-placeholder">
          <span data-i18n="projectPage.screenshotPlaceholder">Screenshot disponibili al completamento del progetto</span>
        </div>
      </section>

      <div class="project-links">
        <a href="https://github.com/Saif-Edin" class="cta-primary" target="_blank" rel="noopener noreferrer">
          GitHub →
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  .project-page {
    padding: 3rem 2rem 6rem;
  }

  .project-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-soft);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 2.5rem;
    transition: color 0.15s;
  }

  .back-link:hover { color: var(--color-primary); }

  .project-header {
    margin-bottom: 3rem;
  }

  .project-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 0.2rem 0.5rem;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .project-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-soft);
  }

  .project-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .project-section h2 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-soft);
    margin-bottom: 1rem;
  }

  .project-section p {
    font-size: 1rem;
    line-height: 1.8;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-pill {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
  }

  .screenshot-placeholder {
    border: 1px dashed var(--color-border);
    padding: 4rem 2rem;
    text-align: center;
    color: var(--color-soft);
    font-size: 0.875rem;
    font-family: var(--font-mono);
  }

  .project-links {
    margin-top: 2.5rem;
  }

  .cta-primary {
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.15s;
  }

  .cta-primary:hover { opacity: 0.85; }
</style>
