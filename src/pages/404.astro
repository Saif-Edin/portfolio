---
import Base from '../layouts/Base.astro'
---

<Base title="404 — SaifEdin">
  <section class="not-found">
    <div class="not-found-inner">
      <span class="not-found-code">404</span>
      <h1 class="not-found-title" data-i18n="notFound.title">Pagina non trovata</h1>
      <p class="not-found-body" data-i18n="notFound.body">La pagina che cerchi non esiste o è stata spostata.</p>
      <a href="/" class="cta-primary" data-i18n="notFound.cta">Torna alla home</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    min-height: calc(100vh - 57px - 97px);
    display: flex;
    align-items: center;
    padding: 4rem 2rem;
  }

  .not-found-inner {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  .not-found-code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-primary);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 1.5rem;
  }

  .not-found-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .not-found-body {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-soft);
    max-width: 50ch;
    margin-bottom: 2.5rem;
  }

  .cta-primary {
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.15s;
  }

  .cta-primary:hover { opacity: 0.85; }
</style>
